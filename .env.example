NODE_ENV=development
LOG_LEVEL=info

# Transport. `stdio` is useful for local MCP clients. `http` is the
# authenticated RaeburnAI-Chain module bridge.
MCP_TRANSPORT=stdio
# One deployment is bound to one tenant until the central per-tenant secret
# broker exists. Production requires this value for both transports.
MCP_TENANT_ID=tenant-id-from-raeburnai-chain
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
# Required for production HTTP transport. Use the same secret as
# RAEBURN_MCP_TOKEN in RaeburnAI-Chain.
RAEBURN_CHAIN_SERVICE_TOKEN=

# Empty means all connectors are enabled when configured.
ENABLED_CONNECTORS=gmail,calendar,github,slack,sharepoint,salesforce,hubspot,notion,google-drive,supabase
ALLOWED_TOOLS=
DENIED_TOOLS=
REQUIRE_APPROVAL_FOR_WRITES=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_REDACT_SECRETS=true
MAX_TOOL_RESULT_BYTES=250000

# Google Workspace: Gmail, Calendar, Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# GitHub
# Production should use fine-grained PATs or GitHub App installation tokens.
# GITHUB_TOKEN is development-only compatibility and is rejected in production.
GITHUB_TOKEN=
GITHUB_READ_TOKEN=
# Exact owner/repository entries; required with a production read token.
GITHUB_ALLOWED_REPOSITORIES=the-raeburn-group/raeburnai-enterprise-mcp-server
# Writes are disabled by default and require a separate credential, a narrower
# allowlist and the normal Chain approval boundary.
GITHUB_ENABLE_WRITES=false
GITHUB_WRITE_TOKEN=
GITHUB_WRITE_ALLOWED_REPOSITORIES=

# Slack
SLACK_BOT_TOKEN=

# Microsoft Graph / SharePoint
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Salesforce
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# HubSpot
HUBSPOT_ACCESS_TOKEN=

# Notion
NOTION_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ALLOWED_TABLES=public_demo_accounts,public_demo_tasks
